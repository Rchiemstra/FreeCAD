{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freecad.org/schemas/photo-inspection-gate-evidence-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "outcome",
    "repositoryCommit",
    "dirtyManifestSha256",
    "testIds",
    "artifacts",
    "reviewers"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "phase": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "narrowed",
        "no-go"
      ]
    },
    "repositoryCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dirtyManifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "testIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^PI-[A-Z]{3}-[0-9]{3}$"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        }
      }
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  }
}
