{
  "schema": "freecad.photo_inspection.mcp_contract",
  "version": "1.0",
  "structured_result_schema": "freecad.photo_inspection.result/1.0",
  "limits": {
    "maximum_request_bytes": 1048576,
    "maximum_image_bytes": 67108864,
    "maximum_profile_bytes": 65536,
    "maximum_response_bytes": 4194304
  },
  "privacy": {
    "image_bytes_in_response": false,
    "absolute_paths_in_response": false,
    "raw_qr_payload_in_log": false,
    "allowed_path_authorities": [
      "workspace",
      "upload",
      "output"
    ]
  },
  "errors": [
    "InvalidInput",
    "CapabilityUnavailable",
    "LeaseRequired",
    "LeaseLost",
    "IdentityMismatch",
    "StaleSource",
    "ProfileMismatch",
    "LowImageQuality",
    "Inconclusive",
    "Cancelled",
    "ResourceLimit",
    "NumericalFailure"
  ],
  "tools": [
    {
      "name": "photo_inspection_capabilities",
      "mutation": false,
      "lease_required": false,
      "asynchronous": false,
      "gui_required": false
    },
    {
      "name": "photo_inspection_validate_profile",
      "mutation": false,
      "lease_required": false,
      "asynchronous": false,
      "gui_required": false
    },
    {
      "name": "photo_inspection_calibrate_camera",
      "mutation": false,
      "lease_required": false,
      "asynchronous": true,
      "gui_required": false
    },
    {
      "name": "photo_inspection_calibrate_printer",
      "mutation": false,
      "lease_required": false,
      "asynchronous": true,
      "gui_required": false
    },
    {
      "name": "photo_inspection_create_sheet",
      "mutation": true,
      "lease_required": true,
      "asynchronous": false,
      "gui_required": false
    },
    {
      "name": "photo_inspection_analyze",
      "mutation": false,
      "lease_required": false,
      "asynchronous": true,
      "gui_required": false
    },
    {
      "name": "photo_inspection_get_status",
      "mutation": false,
      "lease_required": false,
      "asynchronous": false,
      "gui_required": false
    },
    {
      "name": "photo_inspection_cancel",
      "mutation": false,
      "lease_required": false,
      "asynchronous": false,
      "gui_required": false
    },
    {
      "name": "photo_inspection_get_result",
      "mutation": false,
      "lease_required": false,
      "asynchronous": false,
      "gui_required": false
    },
    {
      "name": "photo_inspection_save_result",
      "mutation": true,
      "lease_required": true,
      "asynchronous": false,
      "gui_required": false
    },
    {
      "name": "photo_inspection_export",
      "mutation": true,
      "lease_required": false,
      "asynchronous": false,
      "gui_required_for_formats": [
        "svg",
        "pdf"
      ],
      "headless_formats": [
        "json",
        "csv"
      ]
    }
  ]
}
