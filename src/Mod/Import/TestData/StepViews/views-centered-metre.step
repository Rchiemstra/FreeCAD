ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('FreeCAD hand-authored semantic PMI test; LGPL-2.1-or-later'),'2;1');
FILE_NAME('views-metre.step','2026-10-25T00:00:00',('FreeCAD contributors'),('FreeCAD'),'Hand-authored Part 21','No STEP writer','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;
/* Product -> shape representation -> faceted box, 1 x 2 x 3 inches.
   No OCCT writer output is used in this fixture. */
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','ap242_managed_model_based_3d_engineering',2014,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT('INCH','Independent inch block','',(#3));
#5=PRODUCT_DEFINITION_FORMATION('1','',#4);
#6=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#7=PRODUCT_DEFINITION('design','',#5,#6);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#9=SHAPE_DEFINITION_REPRESENTATION(#8,#10);
#10=FACETED_BREP_SHAPE_REPRESENTATION('',(#11),#80);
#11=FACETED_BREP('Inch block',#12);
#12=CLOSED_SHELL('',(#40,#41,#42,#43,#44,#45));
#20=CARTESIAN_POINT('',(0.,0.,0.));
#21=CARTESIAN_POINT('',(1.,0.,0.));
#22=CARTESIAN_POINT('',(1.,2.,0.));
#23=CARTESIAN_POINT('',(0.,2.,0.));
#24=CARTESIAN_POINT('',(0.,0.,3.));
#25=CARTESIAN_POINT('',(1.,0.,3.));
#26=CARTESIAN_POINT('',(1.,2.,3.));
#27=CARTESIAN_POINT('',(0.,2.,3.));
#30=DIRECTION('',(0.,0.,1.));
#31=DIRECTION('',(1.,0.,0.));
#32=DIRECTION('',(0.,1.,0.));
#33=DIRECTION('',(0.,0.,-1.));
#34=DIRECTION('',(0.,-1.,0.));
#35=DIRECTION('',(-1.,0.,0.));
#40=FACE_SURFACE('',(#50),#60,.T.);
#41=FACE_SURFACE('',(#51),#61,.T.);
#42=FACE_SURFACE('',(#52),#62,.T.);
#43=FACE_SURFACE('',(#53),#63,.T.);
#44=FACE_SURFACE('',(#54),#64,.T.);
#45=FACE_SURFACE('',(#55),#65,.T.);
#50=FACE_OUTER_BOUND('',#70,.T.);
#51=FACE_OUTER_BOUND('',#71,.T.);
#52=FACE_OUTER_BOUND('',#72,.T.);
#53=FACE_OUTER_BOUND('',#73,.T.);
#54=FACE_OUTER_BOUND('',#74,.T.);
#55=FACE_OUTER_BOUND('',#75,.T.);
#60=PLANE('',#66);
#61=PLANE('',#67);
#62=PLANE('',#68);
#63=PLANE('',#69);
#64=PLANE('',#76);
#65=PLANE('',#77);
#66=AXIS2_PLACEMENT_3D('',#20,#33,#31);
#67=AXIS2_PLACEMENT_3D('',#24,#30,#31);
#68=AXIS2_PLACEMENT_3D('',#20,#34,#31);
#69=AXIS2_PLACEMENT_3D('',#23,#32,#31);
#70=POLY_LOOP('',(#20,#23,#22,#21));
#71=POLY_LOOP('',(#24,#25,#26,#27));
#72=POLY_LOOP('',(#20,#21,#25,#24));
#73=POLY_LOOP('',(#23,#27,#26,#22));
#74=POLY_LOOP('',(#20,#24,#27,#23));
#75=POLY_LOOP('',(#21,#22,#26,#25));
#76=AXIS2_PLACEMENT_3D('',#20,#35,#32);
#77=AXIS2_PLACEMENT_3D('',#21,#31,#32);
#80=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#81,#84,#85)) REPRESENTATION_CONTEXT('','inch context'));
#81=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT($,.METRE.));
#82=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#83);
#83=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#84=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#85=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#86=DIMENSIONAL_EXPONENTS(1.,0.,0.,0.,0.,0.,0.);
/* Opposite x faces: nominal 1 inch, signed deviations -0.01 / +0.02. */
#100=SHAPE_ASPECT('left','',#8,.T.);
#101=GEOMETRIC_ITEM_SPECIFIC_USAGE('','',#100,#10,#44);
#102=SHAPE_ASPECT('right','',#8,.T.);
#103=GEOMETRIC_ITEM_SPECIFIC_USAGE('','',#102,#10,#45);
#104=DIMENSIONAL_LOCATION('linear distance','',#100,#102);
#105=(LENGTH_MEASURE_WITH_UNIT() MEASURE_REPRESENTATION_ITEM() MEASURE_WITH_UNIT(POSITIVE_LENGTH_MEASURE(1.),#81) REPRESENTATION_ITEM('nominal value'));
#106=SHAPE_DIMENSION_REPRESENTATION('',(#105),#80);
#107=DIMENSIONAL_CHARACTERISTIC_REPRESENTATION(#104,#106);
#108=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(-0.01),#81);
#109=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.02),#81);
#110=TOLERANCE_VALUE(#108,#109);
#111=PLUS_MINUS_TOLERANCE(#110,#104);
/* Angular dimension in radians, expected 90 degrees. */
#112=SHAPE_ASPECT('bottom','',#8,.T.);
#113=GEOMETRIC_ITEM_SPECIFIC_USAGE('','',#112,#10,#40);
#114=ANGULAR_LOCATION('\X2\89D25EA6\X0\','',#100,#112,.SMALL.);
#115=(MEASURE_REPRESENTATION_ITEM() MEASURE_WITH_UNIT(PLANE_ANGLE_MEASURE(1.5707963267948966),#84) PLANE_ANGLE_MEASURE_WITH_UNIT() REPRESENTATION_ITEM('nominal value'));
#116=SHAPE_DIMENSION_REPRESENTATION('',(#115),#80);
#117=DIMENSIONAL_CHARACTERISTIC_REPRESENTATION(#114,#116);
/* Two ordered datum compartments; unicode identifiers and semantic names. */
#120=DATUM_FEATURE('','',#8,.T.);
#121=GEOMETRIC_ITEM_SPECIFIC_USAGE('','',#120,#10,#44);
#122=DATUM('','\X2\57FA6E96\X0\',#8,.F.,'\X2\03B1\X0\');
#123=SHAPE_ASPECT_RELATIONSHIP('',$,#120,#122);
#124=DATUM_FEATURE('','',#8,.T.);
#125=GEOMETRIC_ITEM_SPECIFIC_USAGE('','',#124,#10,#40);
#126=DATUM('','secondary',#8,.F.,'B');
#127=SHAPE_ASPECT_RELATIONSHIP('',$,#124,#126);
#128=DATUM_REFERENCE_COMPARTMENT('','',#8,.F.,#126,$);
#129=DATUM_REFERENCE_COMPARTMENT('','',#8,.F.,#122,$);
#130=DATUM_SYSTEM('','',#8,.F.,(#129,#128));
/* Angularity has a LENGTH tolerance zone (0.005 inch), not an angle. */
#131=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.005),#81);
#132=(ANGULARITY_TOLERANCE() GEOMETRIC_TOLERANCE('\X2\50BE659C5EA6\X0\','',#131,#102) GEOMETRIC_TOLERANCE_WITH_DATUM_REFERENCE((#130)) GEOMETRIC_TOLERANCE_WITH_MODIFIERS((.FREE_STATE.)));
/* Independently authored cameras: world VRS O=(10,20,30), X=(0,1,0),
   Y=(0,0,1), Z=(1,0,0). Projection point is in VRS coordinates. */
#300=CARTESIAN_POINT('',(10.,20.,30.));
#301=AXIS2_PLACEMENT_3D('',#300,#31,#32);
#302=CARTESIAN_POINT('',(0.,0.,0.));
#303=CARTESIAN_POINT('',(-9.,-6.,4.));
#304=AXIS2_PLACEMENT_3D('',#303,#30,#31);
#305=PLANAR_BOX('',18.,12.,#304);
#306=VIEW_VOLUME(.PARALLEL.,#302,4.,2.,.T.,80.,.T.,.T.,#305);
#307=VIEW_VOLUME(.CENTRAL.,#302,4.,2.,.F.,80.,.T.,.F.,#305);
#308=CARTESIAN_POINT('',(5.,0.,0.));
#309=AXIS2_PLACEMENT_3D('',#308,#31,#32);
#310=PLANE('positive X',#309);
#311=AXIS2_PLACEMENT_3D('',#308,#35,#32);
#312=PLANE('negative X',#311);
#313=CAMERA_MODEL_D3_MULTI_CLIPPING_INTERSECTION('intersection',(#310,#312));
#314=CAMERA_MODEL_D3_MULTI_CLIPPING_UNION('union',(#313,#310));
#315=CAMERA_MODEL_D3_MULTI_CLIPPING('Parallel \X2\89C656FE\X0\',#301,#306,(#310,#312));
#316=CAMERA_MODEL_D3_MULTI_CLIPPING('Perspective',#301,#307,(#310,#312));
/* Real shape and semantic dimension associations, not similarly named objects. */
#320=AXIS2_PLACEMENT_3D('',#20,#30,#31);
#321=REPRESENTATION_MAP(#320,#10);
#322=MAPPED_ITEM('model',#321,#320);
#323=POLYLINE('dimension stroke',(#20,#21));
#324=DRAUGHTING_PRE_DEFINED_COLOUR('white');
#325=DRAUGHTING_PRE_DEFINED_CURVE_FONT('continuous');
#326=CURVE_STYLE('',#325,POSITIVE_LENGTH_MEASURE(0.1),#324);
#327=PRESENTATION_STYLE_ASSIGNMENT((#326));
#328=ANNOTATION_CURVE_OCCURRENCE('dimension graphic',(#327),#323);
#329=DRAUGHTING_CALLOUT('dimension',(#328));
#330=DRAUGHTING_MODEL('views',(#315,#316,#322,#329),#80);
#331=DRAUGHTING_MODEL_ITEM_ASSOCIATION('PMI link','',#104,#330,#329);
ENDSEC;
END-ISO-10303-21;
