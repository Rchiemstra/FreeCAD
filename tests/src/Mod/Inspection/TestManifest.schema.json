{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freecad.org/schemas/photo-inspection-test-manifest-1.0.json",
  "title": "FreeCAD Photo Inspection Test Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "tests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "catalogVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "tests": {
      "type": "array",
      "minItems": 178,
      "maxItems": 178,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "phase",
          "kind",
          "mandatory",
          "stimulus",
          "oracle",
          "requirements",
          "lanes",
          "timeoutSeconds",
          "status",
          "implementedBy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PI-[A-Z]{3}-[0-9]{3}$"
          },
          "category": {
            "enum": [
              "GEO",
              "SHT",
              "CAL",
              "IMG",
              "CMP",
              "LIF",
              "SEC",
              "MCP",
              "PKG",
              "PHY"
            ]
          },
          "phase": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          },
          "kind": {
            "enum": [
              "automated",
              "physical"
            ]
          },
          "mandatory": {
            "const": true
          },
          "stimulus": {
            "type": "string",
            "minLength": 1
          },
          "oracle": {
            "type": "string",
            "minLength": 1
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lanes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 172800
          },
          "status": {
            "enum": [
              "planned",
              "implemented",
              "physical-evidence-required"
            ]
          },
          "implementedBy": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
